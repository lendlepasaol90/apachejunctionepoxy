{
  "name": "apachejunctionepoxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request first so it can redirect www to the main domain;
    // pages and files are then served from ./public.
    "run_worker_first": true
  },
  // RESEND_API_KEY (secret), LEADS_TO_EMAIL and LEADS_FROM_EMAIL are set in the Cloudflare dashboard.
  // keep_vars stops a deploy from wiping them.
  "keep_vars": true,
  "observability": { "enabled": true }
}
