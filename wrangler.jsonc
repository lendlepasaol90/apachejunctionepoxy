{
  "name": "apachejunctionepoxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request first so it can redirect www to the main domain;
    // pages and files are then served from ./public.
    "run_worker_first": true
  },
  // Where estimate requests go and who they come from. Both addresses are on the
  // apachejunctionepoxy.com domain, which is verified in Resend. To change them, edit here.
  "vars": {
    "LEADS_TO_EMAIL": "info@apachejunctionepoxy.com",
    "LEADS_FROM_EMAIL": "Apache Junction Epoxy Flooring <estimates@apachejunctionepoxy.com>"
  },
  // RESEND_API_KEY is a secret set in the Cloudflare dashboard (never in this file).
  // keep_vars stops a deploy from wiping dashboard-only settings.
  "keep_vars": true,
  "observability": { "enabled": true }
}
