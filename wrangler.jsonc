{
  "name": "apachejunctionepoxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request first so it can redirect www to the main domain;
    // pages and files are then served from ./public.
    "run_worker_first": true
  },
  // Where estimate requests go and who they come from. To change them, edit here.
  "vars": {
    "LEADS_TO_EMAIL": "info@apachejunctionepoxy.com",
    "LEADS_FROM_EMAIL": "Apache Junction Epoxy Flooring <info@apachejunctionepoxy.com>"
  },
  // Cloudflare Email Service sends the estimate emails (to a verified address on this account).
  "send_email": [{ "name": "EMAIL" }],
  // keep_vars stops a deploy from wiping settings added in the Cloudflare dashboard.
  "keep_vars": true,
  "observability": { "enabled": true }
}
